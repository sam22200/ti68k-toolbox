#!/bin/sh
# Animated GIF of the TiEmu LCD: ti-gif OUT.gif [SECONDS] [FPS] (default 10 s at 15 fps)
# Use SECONDS=0 to record until Ctrl+C. Writes a 160x100, four-grey GIF directly,
# with unchanged pixels encoded transparently; no intermediate video file.
# Records the LCD area of the window with ffmpeg x11grab while you (or ti-key) play; run it in
# the background: `ti-gif out.gif 20 & ti-key ...; wait`. The window must stay uncovered.
OUT=$1; SEC=${2:-10}; FPS=${3:-15}
[ -n "$OUT" ] || { echo "usage: ti-gif OUT.gif [SECONDS] [FPS]" >&2; exit 2; }
W=$(xdotool search --name '^TiEmu \(' | head -1)
[ -n "$W" ] || { echo "ti-gif: TiEmu window not found" >&2; exit 1; }
eval "$(xwininfo -id "$W" | sed -n 's/.*Absolute upper-left X: *\(-*[0-9]*\)/TI_GIF_X=\1/p; s/.*Absolute upper-left Y: *\(-*[0-9]*\)/TI_GIF_Y=\1/p; s/^ *Width: *\([0-9]*\)/TI_GIF_W=\1/p; s/^ *Height: *\([0-9]*\)/TI_GIF_H=\1/p')"
# Native LCD rectangles read from the Docker image's default .skn headers.
# Scale both endpoints: the calculator window may have been resized by the user.
case "$(xdotool getwindowname "$W")" in
  'TiEmu (TI89t)') TI_GIF_BW=440; TI_GIF_BH=984; TI_GIF_L=63; TI_GIF_T=94; TI_GIF_R=379; TI_GIF_B=294 ;;
  'TiEmu (TI89)') TI_GIF_BW=443; TI_GIF_BH=1006; TI_GIF_L=60; TI_GIF_T=104; TI_GIF_R=379; TI_GIF_B=304 ;;
  *) echo "ti-gif: unsupported skin/model" >&2; exit 1 ;;
esac
TI_GIF_LEFT=$((TI_GIF_L * TI_GIF_W / TI_GIF_BW))
TI_GIF_TOP=$((TI_GIF_T * TI_GIF_H / TI_GIF_BH))
TI_GIF_WIDTH=$(((TI_GIF_R * TI_GIF_W + TI_GIF_BW - 1) / TI_GIF_BW - TI_GIF_LEFT))
TI_GIF_HEIGHT=$(((TI_GIF_B * TI_GIF_H + TI_GIF_BH - 1) / TI_GIF_BH - TI_GIF_TOP))
set --
[ "$SEC" = 0 ] || set -- -t "$SEC"
# Replace the shell so Ctrl+C reaches ffmpeg, which flushes the GIF trailer.
exec ffmpeg -loglevel error -y -f x11grab -framerate "$FPS" -video_size "${TI_GIF_WIDTH}x${TI_GIF_HEIGHT}" \
  -i "$DISPLAY+$((TI_GIF_X + TI_GIF_LEFT)),$((TI_GIF_Y + TI_GIF_TOP))" "$@" \
  -vf "scale=160:100:flags=neighbor,format=gray,lut=y='floor(val/64)*85'" \
  -c:v gif -gifflags +offsetting+transdiff -loop 0 -f gif "$OUT"
