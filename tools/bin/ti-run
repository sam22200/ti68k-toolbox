#!/bin/sh
# Restarts TiEmu from its clean saved state with the files sent at boot, then runs the program.
# Usage: [TI_ARGS=10] ti-run PROG.89z [EXTRA...]   → runs name(TI_ARGS), name = PROG's file name
# Never go back to HOME inside a running build to resend: a restart is faster and always clean.
set -e
D=$(dirname "$0")
NAME=$(basename "$1" | sed 's/\.[^.]*$//')
"$D/ti-emu" restart "$@"
"$D/ti-key" HOME CLEAR CLEAR "$NAME($TI_ARGS)" ENTER
