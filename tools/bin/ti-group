#!/usr/bin/env python3
"""Merges TI-89 files (single variables .89z .89y .89p... or groups .89g) into one group file.

Usage: ti-group OUT.89g FILE...   (groups are flattened; every variable must be in one folder)
TiEmu's -send= keeps only the last file given, so ti-emu sends one group instead.
Layout (TI-GRAPH LINK): 0x3C-byte header (signature, folder, comment, entry count at 0x3A), then
16-byte entries (offset, name[8], type, attr, u16) - a folder entry (type 0x1F, u16 = its
variable count) before the variables - then the file size, A5 5A, and each variable's block
(4 zero bytes, size-prefixed data, checksum) copied unchanged from its single file.
"""
import struct, sys


def read_vars(path):
    d = open(path, 'rb').read()
    if d[:8] not in (b'**TI89**', b'**TI92P*'):
        sys.exit(f'ti-group: {path} is not a TI-89 file')
    n = struct.unpack_from('<H', d, 0x3A)[0]
    entries = [struct.unpack_from('<I8sBB', d, 0x3C + 16 * i) for i in range(n)]
    ends = [e[0] for e in entries[1:]] + [struct.unpack_from('<I', d, 0x3C + 16 * n)[0]]
    folder = d[0x0A:0x12]
    out = []
    for (off, name, vtype, attr), end in zip(entries, ends):
        if vtype == 0x1F:                       # folder entry: its variables follow
            folder = name
            continue
        out.append((folder, name, vtype, attr, d[off:end]))
    return out


def main(out, paths):
    vars_ = [v for p in paths for v in read_vars(p)]
    folder = vars_[0][0]
    if any(v[0] != folder for v in vars_):
        sys.exit('ti-group: variables from several folders')
    names = [v[1] for v in vars_]
    if len(set(names)) != len(names):
        sys.exit('ti-group: duplicate variable names')
    n = len(vars_) + 1
    at = 0x3C + 16 * n + 6
    head = bytearray(b'**TI89**' + b'\x01\x00' + folder + b'group by ti-group'.ljust(40, b'\0'))
    head += struct.pack('<H', n)
    head += struct.pack('<I8sBBH', at, folder, 0x1F, 0, len(vars_))
    blocks = b''
    for _, name, vtype, attr, block in vars_:
        head += struct.pack('<I8sBBH', at + len(blocks), name, vtype, attr, 0)
        blocks += block
    head += struct.pack('<I', at + len(blocks)) + b'\xA5\x5A'
    open(out, 'wb').write(bytes(head) + blocks)


if __name__ == '__main__':
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    main(sys.argv[1], sys.argv[2:])
