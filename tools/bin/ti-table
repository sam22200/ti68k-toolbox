#!/usr/bin/env python3
"""Generates C lookup tables for the TI-89 so nothing is computed at run time.

Each table is `static const`, with the SMALLEST C type that holds its values (unsigned first:
unsigned char < signed char < unsigned short < short < unsigned long < long).

Usage: ti-table KIND [options] > tables.h     (several: ti-table sin cos --scale 127 > trig.h)
  sin / cos   N entries (default 256 = full turn, angle in an unsigned char), value*SCALE
              (default 127 → fits a signed char; 128 does not, use 127 or accept short).
              One sine table is enough: cos(a) = sin_tab[(unsigned char)(a + 64)].
  sqrt        isqrt(i) for i in 0..N-1 (default 256)
  recip       ceil(2^SHIFT / d) for d in 1..N-1, entry 0 = 0 (default N=256, SHIFT=15):
              x / d == (x * recip[d]) >> SHIFT for unsigned x up to the bound printed in the
              table comment (computed by exhaustive check); a 16x16 mulu instead of a divide
  row         i * STRIDE for i in 0..N-1 (default N=128, STRIDE=30: LCD row offsets)
  atan        atan(i/N) in angle units (256 = full turn) for i in 0..N (default N=64):
              first-octant table for atan2 with 8-bit angles
Options: --n N  --scale S  --shift S  --stride S  --name NAME   (default name: KIND_tab)
"""
import math, sys

TYPES = [("unsigned char", 0, 255), ("signed char", -128, 127),
         ("unsigned short", 0, 65535), ("short", -32768, 32767),
         ("unsigned long", 0, 2**32 - 1), ("long", -2**31, 2**31 - 1)]


def smallest_type(values):
    lo, hi = min(values), max(values)
    for name, tmin, tmax in TYPES:
        if tmin <= lo and hi <= tmax:
            return name
    sys.exit(f"ti-table: values out of 32-bit range ({lo}..{hi})")


def emit(name, values, comment):
    ctype = smallest_type(values)
    print(f"// {comment}")
    print(f"// {len(values)} entries, range {min(values)}..{max(values)} → {ctype}")
    print(f"static const {ctype} {name}[{len(values)}] = {{")
    for i in range(0, len(values), 16):
        print("    " + ", ".join(str(v) for v in values[i:i + 16]) + ",")
    print("};\n")


def main(argv):
    kinds, opts = [], {}
    while argv:
        a = argv.pop(0)
        if a in ("-h", "--help"):
            sys.exit(__doc__)
        if a.startswith("--"):
            opts[a[2:]] = argv.pop(0)
        else:
            kinds.append(a)
    if not kinds:
        sys.exit(__doc__)
    print("// Generated by tools/bin/ti-table " + " ".join(sys.argv[1:]) + " — do not edit by hand.\n")
    for kind in kinds:
        n = int(opts.get("n", {"row": 128, "atan": 64}.get(kind, 256)))
        name = opts.get("name", kind + "_tab") if len(kinds) == 1 else kind + "_tab"   # avoid libc names
        if kind in ("sin", "cos"):
            s = int(opts.get("scale", 127))
            f = math.sin if kind == "sin" else math.cos
            emit(name, [round(f(2 * math.pi * i / n) * s) for i in range(n)],
                 f"{kind}(2*pi*i/{n}) * {s}")
        elif kind == "sqrt":
            emit(name, [math.isqrt(i) for i in range(n)], "isqrt(i)")
        elif kind == "recip":
            sh = int(opts.get("shift", 15))
            tab = [0] + [-(-(1 << sh) // d) for d in range(1, n)]      # ceil(2^sh / d)
            bound = 65535                                            # largest x exact for all d
            for d in range(1, n):
                x = 0
                while x <= bound and (x * tab[d]) >> sh == x // d:
                    x += 1
                bound = min(bound, x - 1)
            emit(name, tab, f"ceil(2^{sh} / d), [0] = 0; x/d == (x*{name}[d]) >> {sh} exact for 0 <= x <= {bound}")
        elif kind == "row":
            st = int(opts.get("stride", 30))
            emit(name, [i * st for i in range(n)], f"i * {st}")
        elif kind == "atan":
            emit(name, [round(math.atan(i / n) * 256 / (2 * math.pi)) for i in range(n + 1)],
                 f"atan(i/{n}) in 1/256 turns (first octant, 0..32)")
        else:
            sys.exit(f"ti-table: unknown kind {kind}")


main(sys.argv[1:])
